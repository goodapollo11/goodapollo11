# NurzWorks HQ configuration (all optional). Export these or put them in your service manager.
# Never commit real secrets: integration keys are entered in the app and stored encrypted.

PORT=4200                         # web port (the CMMS uses 4100, so both can run side by side)
NW_HOST=0.0.0.0                   # listen on all interfaces (phones on your Wi-Fi can connect)
NW_DATA_DIR=./data                # where the database, uploads and secret.key live
NW_BASE_URL=                      # public https address, e.g. https://hq.example.com (used in emails, Slack, calendar links)
NW_TRUST_PROXY=                   # set to 1 when behind a tunnel/reverse proxy (Cloudflare, Caddy, Fly.io)
NW_TIMEZONE=America/Chicago       # initial business time zone (change later in Settings)
NW_SECRET_KEY=                    # encrypts saved OAuth tokens & secrets; default: generated data/secret.key
NW_GOOGLE_CLIENT_ID=              # optional: Google OAuth client (can also be entered in Integrations)
NW_GOOGLE_CLIENT_SECRET=
NW_NO_AUTOMATION=                 # set to 1 to disable background jobs (sync, reminders, plans)
